# Roblox
*.rbxlx
*.rbxl
*.rbxm
*.rbxmx

# Build
/build/
/dist/
/node_modules/

# Environment / secrets — never commit credentials
.env
.env.local
*.env
.roblox/
**/open-cloud.env

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Session state (personal)
production/session-state/*.txt
production/session-state/*.json

# Rojo
/rojo.lock

# Wally
/Packages/
/DevPackages/
/wally.lock

# Aftman
/aftman.lock

# Build artifacts
/build.rbxl
/build.rbxlx

# Rojo-synced model files under src are kept
!src/**/*.rbxmx
production/session-state/*.md

# Reference material (not source)
*.apk
/Référence/
/Réference/

# Assets rejetés par la modération Roblox — gardés en local, jamais commités
assets/images/_rejected-moderation/

# assetgen pipeline — caches and raw renders (final PNGs in assets/images/ ARE committed)
tools/assetgen/.cache/
tools/assetgen/out_raw/
# generated mirror sprites (regenerate with tools/assetgen/make_flips.py)
assets/images/*/flip/
# generated combat atlases (regenerate with tools/assetgen/pack_atlas.py)
tools/assetgen/atlas_*.png
tools/assetgen/atlas-manifest.json
tools/assetgen/_atlas_preview.png
__pycache__/
*.pyc
